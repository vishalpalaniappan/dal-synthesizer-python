compositeBehavior("listAverage")

include("computable_units.py")
include("registered.py")

# Simplest form of a composite behavior
# After using this to establish the 
# workflow, I will expand it.

behavior runAverage {
    worldStateManager(
        save_in=unsortedList, 
        transformation=getValue, 
        name="unsortedList",
        p_type="LIST", 
        p_role="UNSORTED_LIST"
    )

    _listAverage(avg, unsortedList)

    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="average",
        value=avg,
        p_type="FLOAT", 
        p_role="LIST_AVERAGE", 
        is_input=False
    )
}

run(runAverage)